  "firestore": {
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public non-PII user profiles for discovering contacts, Snap Map visibility, and Spotlight follows."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "Private PII, birthday, phone number, My Eyes Only PIN hash, privacy settings, and blocked users isolated to the owning user."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/MemoryItem" },
      "description": "User's private Memories including Saved Snaps, Camera Roll uploads, and My Eyes Only items."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User's private notifications feed."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friendships and friend requests between users."
    },
    "/users/{userId}/chats/{conversationId}": {
      "schema": { "$ref": "#/entities/UserChatIndex" },
      "description": "User's private inbox list of conversations with Snap indicators, streaks, unread counts, and preferences."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Authoritative conversation documents for 1-on-1 and group threads."
    },
    "/conversations/{conversationId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ConversationMember" },
      "description": "Member state subcollection tracking roles, typing indicators, and read receipts."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages, voice notes, and disappearing Snaps inside a conversation thread."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour visual Stories shared by users and optionally pinned to Snap Map."
    },
    "/spotlightVideos/{videoId}": {
      "schema": { "$ref": "#/entities/SpotlightVideo" },
      "description": "Short-form public videos posted to the Spotlight feed."
    },
    "/spotlightVideos/{videoId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/SpotlightVideoChunk" },
      "description": "Ordered 720p audio/video data chunks belonging to a SpotlightVideo document."
    },
    "/spotlightVideos/{videoId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/SpotlightComment" },
      "description": "Public comments attached to a Spotlight video."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "Abuse/safety reports submitted by verified users."
    }
  }
}
