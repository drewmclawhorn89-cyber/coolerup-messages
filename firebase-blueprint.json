    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public non-PII user directory profile with Snap Score, Bitmoji config, Trophies, Map coordinates (when not in Ghost Mode), and Spotlight follow lists.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayNameLower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "avatarSeed": {
          "type": "string",
          "maxLength": 120
        },
        "statusText": {
          "type": "string",
          "maxLength": 140
        },
        "snapScore": {
          "type": "integer"
        },
        "trophies": {
          "type": "array",
          "description": "Bounded list of unlocked trophy IDs (max 30)"
        },
        "ghostMode": {
          "type": "boolean"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "locationLabel": {
          "type": "string",
          "maxLength": 120
        },
        "locationUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "followers": {
          "type": "array",
          "description": "Bounded list of follower UIDs (max 500)"
        },
        "following": {
          "type": "array",
          "description": "Bounded list of followed creator UIDs (max 500)"
        },
        "isOnline": {
          "type": "boolean"
        },
        "isDiscoverable": {
          "type": "boolean"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "displayNameLower",
        "handle",
        "photoURL",
        "statusText",
        "isOnline",
        "isDiscoverable",
        "lastSeenAt",
        "createdAt",
        "updatedAt"
      ]
    },
